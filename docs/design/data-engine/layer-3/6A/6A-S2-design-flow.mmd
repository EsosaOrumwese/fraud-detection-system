flowchart TD
  subgraph inputs["Authority inputs"]
    I1["S1 party-universe authority<br/>s1_party_base_6A"]
    I2["Account and product priors<br/>prior_account_per_party_6A, prior_product_mix_6A, taxonomy_account_types_6A"]
    I3["Eligibility and linkage policies<br/>product_linkage_rules_6A and product_eligibility_config_6A"]
    I4["S0 sealed world and digest law"]
  end

  subgraph core["Actual S2 design"]
    C1["Realise account and product counts per party world<br/>deciding which account/product surfaces actually exist"]
    C2["Allocate accounts to parties and merchants under eligibility constraints<br/>and assign static account attributes"]
    C3["Emit both the account base and the derived product-holdings view<br/>so later states read a closed account world instead of inferring one"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["Linkage configs became permissive-default surfaces when sealed optional<br/>the real design preferred explicit warnable absence over blocking the whole account world"]
    S2["The implementation moved to streaming-only parquet emission under fail-closed posture<br/>writer behaviour became part of the actual state design because account scale is large"]
    S3["Performance reopen work stayed inside allocation mechanics only<br/>S2 kept ownership topology and product semantics frozen"]
  end

  subgraph outputs["Owned authority"]
    O1["s2_account_base_6A"]
    O2["s2_party_product_holdings_6A"]
    O3["optional s2_merchant_account_base_6A and summary"]
    O4["rng events, audit, and trace for account realisation"]
    O5["The sole account/product authority<br/>S3-S5 and 6B inherit this world rather than approximating it"]
  end

  I1 --> C1
  I2 --> C1
  I3 --> C2
  I4 --> C1
  C1 --> C2 --> C3

  C3 --> O1
  C3 --> O2
