flowchart TD
  subgraph inputs["Authority inputs"]
    I1["S0 sealed world<br/>s0_gate_receipt_6A and sealed_inputs_6A"]
    I2["Population and segmentation priors<br/>prior_population_6A, prior_segmentation_6A, taxonomy_party_6A"]
    I3["Coarse upstream context only where allowed<br/>merchant and geography surfaces used as population context, not behaviour authority"]
  end

  subgraph core["Actual S1 design"]
    C1["Realise the closed party universe for the world<br/>how many parties exist and in which broad types"]
    C2["Assign stable party identifiers and static segmentation<br/>party_type, segment, region/country context, and other non-behavioural attributes"]
    C3["Emit the bank's read-only party base<br/>the identity surface every later Layer-3 state must consume"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["Because Layer-3 lacked a contracted run-report surface<br/>S1 hardened around S0 gate receipt plus sealed digest as the real precondition"]
    S2["Where no sealed region taxonomy existed, region assignment became a deterministic derived law<br/>not an ad-hoc missing-data patch"]
    S3["Digest and path-template fixes mattered here<br/>S1 had to align itself to the actual S0 sealing law before population authority was trustworthy"]
  end

  subgraph outputs["Owned authority"]
    O1["s1_party_base_6A"]
    O2["optional s1_party_summary_6A"]
    O3["rng events, audit, and trace for population realisation"]
    O4["The sole party-universe authority<br/>later states may classify parties differently only by reading S1, never by recreating them"]
  end

  I1 --> C1
  I2 --> C1
  I3 --> C2
  C1 --> C2 --> C3

  C3 --> O1
  C3 --> O2
  C1 --> O3
  O1 --> O4

  S1 -.-> C1
  S2 -.-> C2
  S3 -.-> C1
