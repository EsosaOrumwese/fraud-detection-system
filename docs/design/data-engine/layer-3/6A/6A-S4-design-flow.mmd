flowchart TD
  subgraph inputs["Authority inputs"]
    I1["S1-S3 sealed entity world<br/>party, account, and instrument bases with linkage tables"]
    I2["Device and IP priors/taxonomies<br/>prior_device_counts_6A, prior_ip_counts_6A, taxonomy_devices_6A, taxonomy_ips_6A"]
    I3["Graph linkage policies<br/>graph_linkage_rules_6A and device_linkage_rules_6A"]
  end

  subgraph core["Actual S4 design"]
    C1["Realise which devices and IP endpoints exist in the bank world"]
    C2["Attach devices and IPs to parties, accounts, instruments, and merchants<br/>to form a static interaction graph"]
    C3["Emit both base tables and link tables<br/>so later behavioural states inherit a closed network world"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["A real design defect surfaced here: S0 role assignments were too coarse<br/>so S4 forced sealed-input role precision back into the upstream gate"]
    S2["Lean fallback paths existed only to survive temporary sealing omissions in dev<br/>the intended design still treats sealed input coverage as the real authority"]
    S3["S4 remained the main network-realism surface<br/>sharing, attachment, and degree structure were kept here instead of leaking into 6B sessions"]
  end

  subgraph outputs["Owned authority"]
    O1["s4_device_base_6A"]
    O2["s4_ip_base_6A"]
    O3["s4_device_links_6A and s4_ip_links_6A"]
    O4["optional neighbourhood summaries and RNG evidence"]
    O5["The sole static device/IP graph authority<br/>6B may animate the graph, but may not rebuild it"]
  end

  I1 --> C1
  I2 --> C1
  I3 --> C2
  C1 --> C2 --> C3

  C3 --> O1
  C3 --> O2
  C3 --> O3
  C1 --> O4
  O1 --> O5

  S1 -.-> C2
  S2 -.-> C1
  S3 -.-> C3
