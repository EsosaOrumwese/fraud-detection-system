flowchart TD
  subgraph inputs["Authority inputs"]
    I1["Upstream HashGates<br/>1A-3B and 5A-5B PASS for the same manifest_fingerprint"]
    I2["Upstream Layer-1 and Layer-2 egress surfaces<br/>merchant, zone, routing, and arrival artefacts discoverable via contracts"]
    I3["6A contracts, priors, taxonomies, and linkage rules<br/>population, products, instruments, devices, IPs, fraud posture"]
    I4["World identity<br/>manifest_fingerprint and parameter_hash"]
  end

  subgraph core["Actual S0 design"]
    C1["Verify that the whole lower engine is sealed and trusted<br/>before Layer-3 entity work may begin"]
    C2["Validate 6A contracts and resolve the full entity-world dependency set"]
    C3["Build sealed_inputs_6A as the only legal read universe<br/>covering upstream egress plus 6A priors/configs"]
    C4["Emit the 6A gate receipt and sealed digest<br/>that every later 6A and 6B state must inherit"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["Large upstream row-level surfaces moved to structural digesting<br/>so S0 stayed control-plane instead of bulk-data hashing"]
    S2["Layer-3 run-report surfaces did not exist as originally implied<br/>so the gate receipt itself became the practical authority boundary"]
    S3["Later S4 role mismatches forced S0 role precision to tighten<br/>sealed-input roles became part of the actual design, not cosmetic metadata"]
  end

  subgraph outputs["Owned authority"]
    O1["sealed_inputs_6A"]
    O2["s0_gate_receipt_6A"]
    O3["Closed entity-world contract for 6A and 6B<br/>what Layer-3 may read, under which roles and scopes"]
  end

  I1 --> C1
  I2 --> C2
  I3 --> C2
  I4 --> C4
  C1 --> C2 --> C3 --> C4

  C3 --> O1
  C4 --> O2
  O1 --> O3
  O2 --> O3

  S1 -.-> C3
  S2 -.-> C4
  S3 -.-> C3
