flowchart TD
  subgraph inputs["Authority inputs"]
    I1["S1 and S2 identity surfaces<br/>party base, account base, and product holdings"]
    I2["Instrument priors and taxonomy<br/>prior_instrument_per_account_6A, prior_instrument_mix_6A, taxonomy_instrument_types_6A"]
    I3["Linkage and eligibility rules<br/>instrument_linkage_rules_6A plus product-linkage context"]
  end

  subgraph core["Actual S3 design"]
    C1["Realise which payment credentials exist for the closed account world<br/>cards, transfer handles, wallet-like credentials, and other instrument types"]
    C2["Attach each credential to specific accounts and parties<br/>without reopening S2 ownership or creating behavioural usage"]
    C3["Assign static credential attributes<br/>type, scheme, masks, expiry, and simple flags"]
    C4["Emit credential bases and link tables<br/>so later graph and fraud states consume a sealed instrument world"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["Optional linkage-rule handling was made explicit here as well<br/>S3 stayed productive even when some policy surfaces were intentionally lean"]
    S2["The actual design kept S3 narrower than the big reopen lanes<br/>it extends the account world into credentials without taking on graph realism or fraud semantics"]
    S3["Streaming writer-only posture was retained<br/>instrument authority had to stay scalable without changing its contract meaning"]
  end

  subgraph outputs["Owned authority"]
    O1["s3_instrument_base_6A"]
    O2["s3_account_instrument_links_6A"]
    O3["s3_party_instrument_holdings_6A"]
    O4["optional summary plus RNG evidence"]
    O5["The sole credential-authority surface<br/>S4 and 6B must not infer credentials for themselves"]
  end

  I1 --> C1
  I2 --> C1
  I3 --> C2
  C1 --> C2 --> C3 --> C4

  C4 --> O1
  C4 --> O2
  C4 --> O3
  C1 --> O4
  O1 --> O5

  S1 -.-> C2
  S2 -.-> C4
  S3 -.-> C4
