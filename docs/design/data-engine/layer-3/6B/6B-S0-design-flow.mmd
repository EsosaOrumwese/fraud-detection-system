flowchart TD
  subgraph inputs["Authority inputs"]
    I1["Upstream HashGates<br/>1A-3B, 5A, 5B, and 6A PASS for the same manifest_fingerprint"]
    I2["Upstream sealed-input manifests and registries<br/>5A, 5B, and 6A contract the worlds below 6B"]
    I3["6B contracts and configs<br/>attachment, flow, fraud, labelling, validation, and RNG packs"]
    I4["World identity<br/>manifest_fingerprint and parameter_hash"]
  end

  subgraph core["Actual S0 design"]
    C1["Verify that the behavioural universe is legal to open<br/>all lower layers sealed and trusted"]
    C2["Resolve exactly which upstream artefacts 6B may read<br/>using sealed manifests first and controlled output-existence fallback only where necessary"]
    C3["Build sealed_inputs_6B and the gate receipt<br/>for the behavioural segment's closed-world contract"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["The actual design insisted on upstream sealed manifests as the primary authority<br/>dictionary-only discovery was rejected as too weak"]
    S2["Because some upstream outputs are not listed in upstream sealed-input manifests<br/>S0 learned a controlled existence-fallback for those real outputs without abandoning closed-world law"]
    S3["Later S3 outputs were added to S0 consumed_by coverage<br/>so downstream validators could keep behavioural closure inside one sealed inventory"]
  end

  subgraph outputs["Owned authority"]
    O1["sealed_inputs_6B"]
    O2["s0_gate_receipt_6B"]
    O3["Closed behavioural-world contract for 6B<br/>what arrivals, entities, configs, and labels may be consumed"]
  end

  I1 --> C1
  I2 --> C2
  I3 --> C2
  I4 --> C3
  C1 --> C2 --> C3

  C3 --> O1
  C3 --> O2
  O1 --> O3
  O2 --> O3

  S1 -.-> C2
  S2 -.-> C2
  S3 -.-> C3
