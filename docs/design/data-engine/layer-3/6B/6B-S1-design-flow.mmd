  end

  subgraph core["Actual S1 design"]
    C1["Attach each arrival to a lawful entity context<br/>party, account, instrument, device, and IP chosen from the closed 6A world"]
    C2["Resolve ambiguity stochastically but lawfully<br/>using behaviour priors and deterministic RNG discipline"]
    C3["Group attached arrivals into sessions<br/>the first durable behavioural structure inside 6B"]
    C4["Emit both arrival-level attachment and session-level summaries<br/>for every later behavioural state"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["A contract omission surfaced here around s4_ip_links_6A<br/>6B had to repair its own registry view instead of silently pretending the link surface did not matter"]
    S2["The actual implementation moved to streaming batch attachment and simpler sessionisation buckets<br/>so S1 stayed scalable without mutating who-can-attach-to-whom semantics"]
    S3["Compression and writer choices became explicit execution surfaces<br/>but S1 remained the sole arrival-to-entity authority"]
  end

  subgraph outputs["Owned authority"]
    O1["s1_arrival_entities_6B"]
    O2["s1_session_index_6B"]
    O3["attachment and session RNG evidence"]
    O4["The sole attachment/session authority<br/>S2-S4 inherit who is acting and which arrivals belong together"]
  end

