flowchart TD
  subgraph inputs["Authority inputs"]
    I1["5B arrival skeleton<br/>arrival_events_5B"]
    I2["6A entity and graph world<br/>parties, accounts, instruments, devices, IPs, and static fraud posture"]
    I3["Attachment and sessionisation policies<br/>attachment_policy_6B, sessionisation_policy_6B, behaviour_config_6B"]
