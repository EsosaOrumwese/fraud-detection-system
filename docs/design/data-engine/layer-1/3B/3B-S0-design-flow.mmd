flowchart TD
  subgraph inputs["Authority inputs"]
    I1["upstream PASS bundles and flags:<br/>1A, 1B, 2A, 3A"]
    I2["upstream egress surfaces needed by 3B"]
    I3["sealed 3B policies and refs:<br/>mcc_channel_rules, settlement coords,<br/>validation/logging policy, route RNG,<br/>alias layout, day effect, merchant universe refs"]
