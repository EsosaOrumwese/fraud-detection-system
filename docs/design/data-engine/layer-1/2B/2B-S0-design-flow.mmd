flowchart TD
  subgraph inputs["Authority inputs"]
    I1["1B validation bundle<br/>and PASS flag"]
    I2["1B site_locations realism surface"]
    I3["2A site_timezones authority"]
    I4["optional 2A tz_timetable_cache"]
    I5["routing policy packs:<br/>route_rng, alias_layout, day_effect,<br/>group_mix_regularizer, virtual_edge"]
    I6["optional run-scoped s5_arrival_roster"]
  end

  subgraph core["Actual S0 design"]
    C1["Verify upstream 1B validation authority<br/>before any downstream routing read"]
    C2["Resolve exact dictionary-bound inputs<br/>and policy artefacts for this manifest"]
    C3["Seal the routing environment as one governed world:<br/>site layout, timezone truth, policy digests,<br/>and optional roster witness"]
    C4["Bind all later 2B runtime evidence to one<br/>manifest_fingerprint and created_utc root"]
    C5["Publish gate receipt and sealed inventory"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["Bundle/flag parsing and schema lookup were hardened so S0 fails closed<br/>on real upstream identity defects rather than fragile reader behavior"]
    S2["policy_version resolution replaced loose version_tag handling;<br/>policy digests became explicit design artefacts, not incidental metadata"]
    S3["optional s5_arrival_roster sealing was added later so standalone S5 reads<br/>can remain catalogued and governed when the roster already exists"]
    S4["S0 stayed a trust boundary only; validation publication and downstream realism<br/>ownership were deliberately left to later states"]
  end

  subgraph outputs["Owned authority"]
    O1["sealed_inputs_2B"]
    O2["s0_gate_receipt_2B"]
    O3["manifest-scoped routing world<br/>that S1-S8 are allowed to trust"]
  end

  I1 --> C1
  I2 --> C2
  I3 --> C2
  I4 --> C2
  I5 --> C2
  I6 --> C2
  C1 --> C2 --> C3 --> C4 --> C5
  C5 --> O1
  C5 --> O2
  C4 --> O3

  S1 -.-> C1
  S2 -.-> C2
  S3 -.-> C3
  S4 -.-> C5
