flowchart TD
  subgraph inputs["Authority inputs"]
    I1["S1 provisional timezone rows<br/>including source, override_applied, and override_scope evidence"]
    I2["S0-sealed tz_overrides and optional merchant_mcc_map<br/>with expiry and provenance law"]
    I3["tz_world tzid set and cutoff date<br/>for membership and active-policy validation"]
  end

  subgraph core["Actual S2 design"]
    C1["Evaluate canonical override precedence<br/>site over mcc over country under the sealed cutoff date"]
    C2["Finalize exactly one tzid per site<br/>either preserving polygon truth or applying the lawful override"]
    C3["Enforce provenance completeness, tzid membership, rate caps, and coverage parity<br/>so finalization is governed rather than permissive"]
    C4["Publish site_timezones as the final timezone authority surface<br/>for timetable and legality states"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["S2 became the canonical override-governance state<br/>because provisional rescue in S1 was not strong enough to support downstream legality alone"]
    S2["Global and country-level override budgets were promoted into fail-closed design law<br/>so governance is judged here, not later in reporting"]
    S3["An experimental topology-rebalance lane was tried for downstream support<br/>but it was deliberately reverted from mainline, leaving actual S2 as finalization authority rather than redistribution logic"]
  end

  subgraph outputs["Owned authority"]
    O1["site_timezones"]
    O2["s2_run_report with override governance and provenance counters"]
    O3["Exactly one final tzid per site under canonical precedence law"]
    O4["Downstream contract:<br/>S3 and S4 must treat site_timezones as final timezone truth, not reopen override choice"]
  end

  I1 --> C1
  I2 --> C1
  I3 --> C3
  C1 --> C2 --> C3 --> C4

  C4 --> O1
  C4 --> O2
  O1 --> O3
  O1 --> O4

  S1 -.-> C1
  S2 -.-> C3
  S3 -.-> C2
