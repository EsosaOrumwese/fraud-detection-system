flowchart TD
  subgraph inputs["Authority inputs"]
    I1["1B validation bundle, index, and PASS flag<br/>for the upstream manifest_fingerprint"]
    I2["1B site_locations<br/>the certified spatial surface entering civil-time logic"]
    I3["Civil-time reference and policy assets<br/>tz_world, tzdb_release, tz_overrides, tz_nudge, optional merchant_mcc_map"]
    I4["Run identity from upstream receipt<br/>seed, parameter_hash, manifest_fingerprint"]
  end

  subgraph core["Actual S0 design"]
    C1["Verify 1B closed for this manifest_fingerprint<br/>No PASS means no civil-time read"]
    C2["Resolve and validate the minimal civil-time ingress world<br/>schema anchors, release metadata, CRS, licence/governance surfaces"]
    C3["Seal the exact inputs that later 2A states may trust<br/>including override policy and tzdb release authority"]
    C4["Publish gate receipt and sealed inventory<br/>or fail closed with no partial 2A world"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["2A identity posture was corrected to upstream-manifest authority<br/>S0 verifies the fingerprint; it does not derive a new one from sealing"]
    S2["The sealed set was kept intentionally minimal<br/>only the assets real downstream states use are carried into the manifest"]
    S3["tz_world-derived tzid indexing became part of gate legitimacy<br/>so override policies can be fail-closed before lookup/finalization"]
    S4["Release-tag resolution for tzdb had to become explicit<br/>because contract tokens alone were too weak to identify the real release root"]
  end

  subgraph outputs["Owned authority"]
    O1["s0_gate_receipt_2A"]
    O2["sealed_inputs_2A"]
    O3["One lawful civil-time read world<br/>for S1 through S5"]
    O4["Fail-closed rule:<br/>without S0 receipt and sealed inputs, 2A has no authority to interpret time"]
  end

  I1 --> C1
  I2 --> C2
  I3 --> C2
  I4 --> C1
  C1 --> C2 --> C3 --> C4

  C4 --> O1
  C4 --> O2
  O2 --> O3
  O1 --> O4

  S1 -.-> C1
  S2 -.-> C3
  S3 -.-> C2
  S4 -.-> C2
