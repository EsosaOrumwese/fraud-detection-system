flowchart TD
  subgraph inputs["Authority inputs"]
    I1["S3 timetable cache, S4 legality report, and S2 site_timezones<br/>the final 2A evidence surfaces"]
    I2["Validation-bundle contract law<br/>checks file, index, digest, flag, and partition purity"]
    I3["Run identity<br/>seed and manifest_fingerprint discover the final publish scope"]
  end

  subgraph core["Actual S5 design"]
    C1["Assemble the 2A evidence story<br/>cache evidence, legality evidence, site_timezones checks, and digest/index material"]
    C2["Judge whether the evidence set is internally coherent and fail-closed safe<br/>before any PASS claim is emitted"]
    C3["Publish validation bundle, index, and PASS flag only when the final civil-time story is lawful"]
  end

  subgraph shifts["Implemented design shifts"]
    S1["S5 became the real downstream contract for 2A<br/>no PASS means no later consumer should trust site_timezones"]
    S2["A deterministic existing-bundle reuse path was added for warm lanes<br/>but only when evidence bytes and digest are exactly unchanged"]
    S3["The state remains a full-strength correctness gate<br/>performance work accelerated packaging, not legal or governance judgment"]
  end

  subgraph outputs["Owned authority"]
    O1["validation_bundle_2A"]
    O2["validation_bundle_index_2A"]
    O3["validation_passed_flag_2A"]
    O4["Final consumer rule:<br/>site_timezones is only a lawful downstream authority surface after S5 PASS"]
  end

  I1 --> C1
  I2 --> C2
  I3 --> C1
  C1 --> C2 --> C3

  C3 --> O1
  C3 --> O2
  C3 --> O3
  O3 --> O4

  S1 -.-> C3
  S2 -.-> C1
  S3 -.-> C2
